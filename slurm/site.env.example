# Site settings for slurm/launch.sh. Copy to slurm/site.env (ignored by git) and use
# absolute paths that every colleague can read.

# kairos-lr results directory the store was built from (needed only to rebuild)
RESULTS=/abs/path/to/kairos-lr/result/<run>
# hgt_viz store (directory with meta.json); must be readable by colleagues
STORE=/abs/path/to/hgt_viz_store
# conda env with the app's dependencies: a name, or an absolute env path that
# colleagues can read (e.g. /home/<you>/.conda/envs/hgt_viz)
ENV=/abs/path/to/conda/envs/hgt_viz
# login node used in the printed ssh tunnel command
LOGIN_HOST=login.example.org
# optional
#PARTITION=shared
#PORT=8501
